{
  "name": "svelte-boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "stylelint": "stylelint './**/*.css' --config ./stylelint.config.cjs",
    "eslint": "eslint . --color",
    "eslint:fix": "eslint --fix",
    "format": "prettier --write --plugin prettier-plugin-svelte . --config ./.prettierrc",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "generate:sitemap": "bun run ./src/services/generateSitemap.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.7",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dayjs": "^1.11.19",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-svelte": "^3.15.0",
    "lodash": "^4.17.23",
    "path-browserify": "^1.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.0.1",
    "stylelint": "^17.2.0",
    "stylelint-config-recommended": "^18.0.0",
    "svelte": "^5.50.3",
    "svelte-check": "^4.3.6",
    "svelte-eslint-parser": "^1.4.1",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.55.0",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.5",
    "svelte-i18n": "^4.0.1",
    "svelte-spa-router": "^5.0.0"
  }
}
